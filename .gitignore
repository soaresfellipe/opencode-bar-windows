# build outputs
OpenCodeBar.exe
src/opencode-bar.ico
*.zip

# generic build/IDE output directories (the app has none, but a contributor's
# tooling might create them)
build/
target/
node_modules/

# preview renders other than the README screenshot
docs/*-icon.png

# editors / OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db
*.user

# test runner output
testResults.xml
coverage.xml

# local secrets / env overrides. .env.example IS tracked; .env never is.
.env
.env.*
!.env.example
